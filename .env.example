# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed with real secrets.

# --- Supabase (Project Settings -> API) ---
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
SUPABASE_URL="https://your-project-ref.supabase.co"

# Same values, exposed to the client build (Vite requires the VITE_ prefix).
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Service-role key, server-only, bypasses Row Level Security.
# Required for admin server functions (user management, transports admin, etc).
SUPABASE_SERVICE_ROLE_KEY=""

# --- AI features (optional) ---
# Enables: AI reading of transport documents/PDFs, monthly transport
# insights, attendance forecast, survey translation. If left empty, the
# app runs fine and these features degrade gracefully (a clear
# "AI not available" message is shown instead of erroring).
#
# Default provider is OpenRouter (https://openrouter.ai) using the same
# "provider/model" ids already used in the code (e.g. google/gemini-2.5-flash).
AI_GATEWAY_API_KEY=""
# Only needed if you want a different OpenAI-compatible provider/endpoint:
# AI_GATEWAY_URL="https://openrouter.ai/api/v1/chat/completions"
# AI_GATEWAY_AUTH_HEADER="Authorization"
